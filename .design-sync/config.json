    "ChampionBadge": "src/components/ChampionBadge.tsx",
    "ChestIcon": "src/components/ChestIcon.tsx",
    "CoinIndicator": "src/components/CoinIndicator.tsx",
    "DailyLeaderboardTable": "src/components/DailyLeaderboardTable.tsx",
    "EmptyState": "src/components/EmptyState.tsx",
    "HomeModeTabs": "src/components/HomeModeTabs.tsx",
    "LockedFeatureHint": "src/components/LockedFeatureHint.tsx",
    "PenSkinGlyph": "src/components/PenSkinGlyph.tsx",
    "ResultComparison": "src/components/ResultComparison.tsx",
    "ScoreCard": "src/components/ScoreCard.tsx",
