# Cloudflare Web Analytics beacon token (Analytics & Logs -> Web Analytics -> Add a
# site -> playcydi.com, in the Cloudflare dashboard). Must be prefixed with VITE_ so
# Vite exposes it to index.html. Leave unset locally - the beacon only loads on the
# production hostnames anyway (see index.html).
VITE_CF_WEB_ANALYTICS_TOKEN=

# Production AdMob rewarded ad unit ID (AdMob console -> the CYDI app -> Ad units).
# Read ONLY by production builds - dev and internal-test builds always resolve
# Google's public demo units instead, see the ID policy at the top of
# src/services/ads/adConfig.ts. Left blank here on purpose: set the real value in an
# untracked .env.production.local (or in CI). A blank value is safe - the rewarded
# format then resolves to "" and is silently skipped rather than erroring.
VITE_ADMOB_REWARDED_ANDROID=
