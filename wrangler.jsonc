{
  "name": "cydi",
  "compatibility_date": "2026-07-07",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // A request matching a real asset normally bypasses the Worker entirely, so
    // "/" was served straight from dist/index.html and never reached the SEO
    // <head>/copy rewriting in worker/index.ts.
    //
    // This list REPLACES the default routing rather than adding to it: any path
    // not matched here is answered by the asset server alone (falling back to
    // index.html per not_found_handling) and never invokes the Worker - a
    // positive-only list would silently swallow /api/* the day someone forgot to
    // add a route to it. So the rule is inverted: everything runs the Worker
    // first, minus the purely static directories, which keep being served
    // directly exactly as before (including /.well-known/assetlinks.json, which
    // Android App Link verification depends on).
    //
    // The page paths below are PRERENDERED into dist/ by scripts/prerenderPages.ts
    // (run from `npm run build`), so the asset server can answer them without the
    // Worker. That is not a quota measure - together they are ~0.4% of Worker
    // invocations - it is an availability one: on 24 Sep 2026 the Workers runtime hit
    // its daily limit and every Worker-invoking path returned 429 for four and a half
    // hours while these excluded paths kept serving 200. A cold visit to "/" was dead,
    // and Classic needs nothing but the shell to play.
    //
    // Each entry must have a matching prerendered file or the path falls to the SPA
    // shell with the wrong <head>. prerenderPaths() and this list are checked against
    // each other in worker/prerender.test.ts, so adding an SEO page without adding it
    // here (or vice versa) fails the build rather than silently losing a canonical.
    //
    // The Worker's own handlers for these paths stay in place and stay correct. They
    // simply stop receiving traffic, which means a mistake here degrades to today's
    // behaviour instead of a 404.
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/images/*",
      "!/admin/*",
      "!/.well-known/*",
      "!/favicon.svg",
      "!/app-ads.txt",
      // Prerendered SEO landing pages (worker/seoPages.ts).
      "!/",
      "!/drawing-accuracy-test",
      "!/draw-a-perfect-circle",
      "!/draw-a-perfect-star",
      "!/draw-a-perfect-heart",
      "!/draw-a-dog-from-memory",
      "!/draw-shapes-online",
      "!/multiplayer-drawing-game",
      "!/2-player-drawing-game-one-phone",
      "!/draw-a-cat-from-memory",
      "!/draw-a-bear-from-memory",
      "!/draw-an-owl-from-memory",
      "!/draw-a-pig-from-memory",
      "!/draw-a-snail-from-memory",
      "!/draw-a-lightning-bolt-from-memory",
      "!/draw-a-triangle-from-memory",
      "!/drawing-challenges",
      // Prerendered content documents (worker/contentPages.ts).
      "!/how-to-play",
      "!/about",
      "!/contact",
      "!/terms",
      "!/privacy",
      "!/accessibility",
      // Generated text, derived from CONTENT_PATHS.
      "!/robots.txt",
      "!/sitemap.xml"
    ]
  },
  "kv_namespaces": [
    {
      // Shared drawings/challenges ONLY (see worker/index.ts share routes).
      "binding": "SHARE_KV",
      "id": "27ae6995fdef4040ac555ee8f1830bee"
    },
    {
      // Dynamic content catalog releases (content:catalog:<releaseId>,
      // content:active, content:releases) - deliberately separated from
      // SHARE_KV so content publishing can never touch user share data.
      // Real namespaces created 2026-07-22 on the playcydi Cloudflare
      // account (empty; wired here but not yet serving until deploy):
      //   id         -> production namespace
      //   preview_id -> `wrangler dev --remote` / preview deploys
      // `wrangler dev --local` ignores both and keys off the binding name.
      "binding": "CONTENT_KV",
      "id": "17ed84bd6bea49d08f6aad52c57c0952",
      "preview_id": "35365d9060f74390aad633564e0241ef"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DAILY_CHALLENGE_DO",
        "class_name": "DailyChallengeDO"
      },
      {
        "name": "ANALYTICS_DO",
        "class_name": "AnalyticsDO"
      },
      {
        // Play Together: one Durable Object instance per room code, addressed
        // with idFromName(code). Unlike the two bindings above (which each have
        // a single global instance), this one is created and destroyed with the
        // rooms themselves. See worker/roomDO.ts.
        "name": "ROOM_DO",
        "class_name": "RoomDO"
      }
    ]
  },
  // Phase 1 Analytics Engine SHADOW write (worker/analyticsShadow.ts): a best-effort
  // copy of accepted analytics envelopes, taken before sampling. Nothing reads it yet;
  // AnalyticsDO stays the system of record. writeDataPoint() is not a subrequest and
  // not a DO request (measured 25 Sep 2026), so this adds no load on the Free caps.
  // Removing this block turns the shadow off with no other change - the binding is
  // optional in Env.
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS_AE",
      "dataset": "cydi_analytics_shadow_v1"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DailyChallengeDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["AnalyticsDO"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["RoomDO"]
    }
  ],
  // Secrets the Worker cannot run without. Declaring them here makes wrangler
  // validate their presence (never their value) at upload/dev time, so a
  // `versions upload` that is missing CONTENT_ADMIN_TOKEN is caught instead of
  // silently shipping a build where content-admin auth can never succeed.
  // Values are set out-of-band (`wrangler secret put` / dashboard) and unchanged
  // secrets carry forward from the previous version - they are never in the repo.
  "secrets": {
    "required": ["CONTENT_ADMIN_TOKEN", "ANALYTICS_ADMIN_TOKEN"]
  }
}
