{
  "name": "cydi",
  "compatibility_date": "2026-07-07",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // A request matching a real asset normally bypasses the Worker entirely, so
    // "/" was served straight from dist/index.html and never reached the SEO
    // <head>/copy rewriting in worker/index.ts.
    //
    // This list REPLACES the default routing rather than adding to it: any path
    // not matched here is answered by the asset server alone (falling back to
    // index.html per not_found_handling) and never invokes the Worker - a
    // positive-only list would silently swallow /api/* the day someone forgot to
    // add a route to it. So the rule is inverted: everything runs the Worker
    // first, minus the purely static directories, which keep being served
    // directly exactly as before (including /.well-known/assetlinks.json, which
    // Android App Link verification depends on).
    "run_worker_first": ["/*", "!/assets/*", "!/images/*", "!/admin/*", "!/.well-known/*", "!/favicon.svg", "!/app-ads.txt"]
  },
  "kv_namespaces": [
    {
      // Shared drawings/challenges ONLY (see worker/index.ts share routes).
      "binding": "SHARE_KV",
      "id": "27ae6995fdef4040ac555ee8f1830bee"
    },
    {
      // Dynamic content catalog releases (content:catalog:<releaseId>,
      // content:active, content:releases) - deliberately separated from
      // SHARE_KV so content publishing can never touch user share data.
      // Real namespaces created 2026-07-22 on the playcydi Cloudflare
      // account (empty; wired here but not yet serving until deploy):
      //   id         -> production namespace
      //   preview_id -> `wrangler dev --remote` / preview deploys
      // `wrangler dev --local` ignores both and keys off the binding name.
      "binding": "CONTENT_KV",
      "id": "17ed84bd6bea49d08f6aad52c57c0952",
      "preview_id": "35365d9060f74390aad633564e0241ef"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DAILY_CHALLENGE_DO",
        "class_name": "DailyChallengeDO"
      },
      {
        "name": "ANALYTICS_DO",
        "class_name": "AnalyticsDO"
      },
      {
        // Play Together: one Durable Object instance per room code, addressed
        // with idFromName(code). Unlike the two bindings above (which each have
        // a single global instance), this one is created and destroyed with the
        // rooms themselves. See worker/roomDO.ts.
        "name": "ROOM_DO",
        "class_name": "RoomDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DailyChallengeDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["AnalyticsDO"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["RoomDO"]
    }
  ],
  // Secrets the Worker cannot run without. Declaring them here makes wrangler
  // validate their presence (never their value) at upload/dev time, so a
  // `versions upload` that is missing CONTENT_ADMIN_TOKEN is caught instead of
  // silently shipping a build where content-admin auth can never succeed.
  // Values are set out-of-band (`wrangler secret put` / dashboard) and unchanged
  // secrets carry forward from the previous version - they are never in the repo.
  "secrets": {
    "required": ["CONTENT_ADMIN_TOKEN", "ANALYTICS_ADMIN_TOKEN"]
  }
}
